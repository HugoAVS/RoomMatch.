# Copia este archivo como backend/.env y ajusta los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore); este ejemplo sí.

PORT=4000

# Base de datos local: la que levanta `docker compose up -d` (puerto 5433 en el equipo).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rommatch?schema=public"

# Orígenes del frontend permitidos (separados por coma). Solo hace falta en desarrollo,
# cuando el frontend (Vite) corre en otro puerto que la API.
CORS_ORIGIN="http://localhost:5174,http://localhost:4174,http://localhost:5173"

# --- Solo para producción (en Render ya vienen definidos en render.yaml) ---
# SERVE_FRONTEND=true   → la API también sirve el frontend compilado (frontend/dist)
# AUTO_SEED=true        → si la base de datos está vacía, crea los datos de demostración
